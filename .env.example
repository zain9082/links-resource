# ============================================================
# Links Resource — Environment Variables
# Copy to .env and fill in values: cp .env.example .env
# ============================================================

# --- Required for auth (login, signup, admin) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/links_resource"
AUTH_SECRET=""  # Generate with: npx auth secret

# --- Strongly recommended for production SEO ---
NEXT_PUBLIC_SITE_URL="https://linksresource.com"

# --- Database seed (run once: npm run db:seed) ---
SEED_ADMIN_PASSWORD="choose-a-strong-password"

# --- Google Search Console verification ---
# Get from: https://search.google.com/search-console → Add property → HTML tag
GOOGLE_SITE_VERIFICATION=""

# --- Optional OAuth providers ---
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# --- DigitalOcean deploy (npm run deploy:do) ---
# Get token: https://cloud.digitalocean.com/account/api/tokens
DIGITALOCEAN_TOKEN=""
# AUTH_URL="https://linksresource.com"
# AUTH_TRUST_HOST="true"
